# Google Cloud
# FM 患者テストの場合: yorisoi-senikintsu-syndo
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Firestore は Application Default Credentials を使用
# ローカル開発時: gcloud auth application-default login
# FM デプロイ前の確認: ./scripts/setup-fm-dev.sh
# セットアップ手順: docs/fm-deploy-setup-guide.md

# LIFF
LIFF_CHANNEL_ID=your-line-channel-id

# Gemini API (AI入力補助：音声解析・お薬手帳スキャン・検査結果読み取り)
# 必須 — FM 写真服薬登録・検査値 AI 読取で使用
GEMINI_API_KEY=your-gemini-api-key

# サーバー
PORT=8080
ALLOW_ORIGIN=https://yorisoi.medi-canvas.com
DEMO_MODE=1
